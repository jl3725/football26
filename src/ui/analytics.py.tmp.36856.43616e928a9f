        "</div></div></div></div>"
    )


def _stat_accent(value) -> str:
    """능력치 값 → 절제된(채도 낮은) 등급 액센트. 카테고리별 알록달록 대신 품질 기준."""
    try:
        v = float(value)
    except (TypeError, ValueError):
        return "#7c8aa0"
    if v >= 82:
        return "#5ec98a"   # mint (우수)
    if v >= 74:
        return "#6aa6e0"   # soft blue (양호)
    if v >= 66:
        return "#caa64e"   # muted gold (보통)
    return "#d98169"       # soft terracotta (보강)


def _game_tile_html(label: str, value, note: str = "", maxv: int = 99) -> str:
    accent = _stat_accent(value)
    try:
        pct = max(5, min(100, int(round(float(value) / maxv * 100))))
    except (TypeError, ValueError):
        pct = 50
    note_html = (
        f"<div style='font-size:10px;color:#7e8a9c;margin-top:6px;white-space:nowrap;"
        f"overflow:hidden;text-overflow:ellipsis'>{html.escape(note)}</div>" if note else ""
    )
    return (
        "<div style='background:linear-gradient(158deg,#1d2636,#10151e);border:1px solid #28303f;"
        "border-radius:12px;padding:11px 12px;box-shadow:0 2px 9px rgba(0,0,0,.20)'>"
        f"<div style='font-size:9.5px;font-weight:900;color:#8b97aa;letter-spacing:.7px'>{html.escape(label)}</div>"
        f"<div style='display:flex;align-items:baseline;gap:5px;margin:5px 0 7px'>"
        f"<span style='font-size:25px;font-weight:950;color:#fff;line-height:1'>{html.escape(str(value))}</span>"
        f"<span style='width:6px;height:6px;border-radius:50%;background:{accent};box-shadow:0 0 6px {accent}'></span></div>"
        "<div style='height:5px;border-radius:999px;background:rgba(255,255,255,.10);overflow:hidden'>"
        f"<div style='height:100%;width:{pct}%;background:{accent};border-radius:999px'></div></div>"
        f"{note_html}</div>"
    )


# ── Match Factor Lab ─────────────────────────────────────────────────────────
def _drop_gk(sq: pd.DataFrame) -> pd.DataFrame:
    """필드 스탯 팩터에서 골키퍼 제외 — 키퍼는 필드 지표가 0이라 기여/보완 칩에 오염을 준다."""
    if "pos" in sq.columns:
        return sq[~sq["pos"].fillna("").astype(str).str.contains("GK", case=False)]
    return sq


def _player_metric_leaders(team: str, full_df: pd.DataFrame, metrics: list[str],
                           mode: str = "sum", n: int = 3, min_minutes: int = 450,
                           exclude_gk: bool = True) -> list[tuple[str, float]]:
    if full_df is None or full_df.empty or "squad" not in full_df.columns or "player" not in full_df.columns:
        return []
    sq = full_df[full_df["squad"].astype(str) == team].copy()
    if exclude_gk:
        sq = _drop_gk(sq)
    if sq.empty:
        return []
    if "minutes" in sq.columns:
        sq = sq[pd.to_numeric(sq["minutes"], errors="coerce").fillna(0) >= min_minutes]
    available = [m for m in metrics if m in sq.columns]
    if not available or sq.empty:
        return []
    vals = [pd.to_numeric(sq[m], errors="coerce").fillna(0) for m in available]
    sq["_factor_score"] = sum(vals) / len(vals) if mode == "avg" else sum(vals)
    sq = sq.sort_values("_factor_score", ascending=False)
    return [(str(r["player"]), float(r["_factor_score"])) for _, r in sq.head(n).iterrows()]


def _player_metric_gaps(team: str, full_df: pd.DataFrame, metrics: list[str],
                        n: int = 2, min_minutes: int = 900,
                        exclude_gk: bool = True) -> list[tuple[str, float]]:
    if full_df is None or full_df.empty or "squad" not in full_df.columns or "player" not in full_df.columns:
        return []
    sq = full_df[full_df["squad"].astype(str) == team].copy()
    if exclude_gk:
        sq = _drop_gk(sq)
    if sq.empty:
        return []
    if "minutes" in sq.columns:
        sq = sq[pd.to_numeric(sq["minutes"], errors="coerce").fillna(0) >= min_minutes]
    available = [m for m in metrics if m in sq.columns]
    if not available or sq.empty:
        return []
    vals = [pd.to_numeric(sq[m], errors="coerce").fillna(0) for m in available]
    sq["_factor_gap"] = sum(vals) / len(vals)
    sq = sq.sort_values("_factor_gap", ascending=True)
    return [(str(r["player"]), float(r["_factor_gap"])) for _, r in sq.head(n).iterrows()]


def _player_chips(rows: list[tuple[str, float]], pmap: dict, tcol: str, size: int = 26,
                  dark: bool = False) -> str:
    """기여/보완 선수를 작은 아바타 + 성(姓) 칩으로 렌더."""
    name_col = "#dbe3f0" if dark else "#1a1f2e"
    empty_col = "#5f6b82" if dark else "#8a93a5"
    if not rows:
        return f"<div style='font-size:11px;color:{empty_col};margin-top:5px'>데이터 확인 필요</div>"
    out = []
    for name, _ in rows:
        short = html.escape(name.split()[-1] if name else "")
        out.append(
            "<div style='display:flex;align-items:center;gap:7px'>"
            f"{avatar(pmap.get(name, ''), tcol, size, 'flex:none')}"
            f"<span style='font-size:11.5px;font-weight:900;color:{name_col};white-space:nowrap;"
            f"overflow:hidden;text-overflow:ellipsis'>{short}</span></div>"
        )
    return "<div style='display:flex;flex-direction:column;gap:7px;margin-top:7px'>" + "".join(out) + "</div>"


# ── Game-engine (FIFA/PES) 비주얼 토큰 — 다크 HUD / FUT 카드 룩 ────────────────
_GE_TXT = "#e8edf6"      # 본문 밝은 텍스트
_GE_SUB = "#8b97ad"      # 보조 텍스트
_GE_MUT = "#5f6b82"      # 흐린 텍스트
_GE_LINE = "rgba(125,145,185,.16)"   # 내부 구분선

def _ge_panel_style(accent: str, radius_cut: int = 16) -> str:
    """다크 + 클립된 모서리 + 네온 악센트 글로우 패널 스타일."""
    return (
        "background:linear-gradient(155deg,#18203250,#0d132080),"
        "linear-gradient(155deg,#161d2e,#0d1320);"
        f"border:1px solid {accent}3a;border-radius:4px;"
        f"clip-path:polygon(0 0,calc(100% - {radius_cut}px) 0,100% {radius_cut}px,100% 100%,0 100%);"
        f"box-shadow:0 0 0 1px {accent}14,0 12px 30px rgba(0,0,0,.40),inset 0 1px 0 rgba(255,255,255,.04)"
    )

def _ge_rating_color(v: float) -> str:
    """FIFA OVR식 등급 색 — 높을수록 초록."""
    if v >= 80:
        return "#3ddc84"
    if v >= 70:
        return "#a3e635"
    if v >= 60:
        return "#fbbf24"
    return "#f87171"

def _ge_section_title(label: str, sub: str = "", accent: str = "#22d3ee") -> str:
    """HUD식 섹션 헤더 — 좌측 네온 바 + 대문자 라벨(밝은 페이지 배경용 다크 텍스트)."""
    sub_html = (f"<span style='font-size:10.5px;font-weight:800;color:#8a93a5;"
                f"letter-spacing:.3px;margin-left:10px'>{html.escape(sub)}</span>") if sub else ""
    return (
        "<div style='display:flex;align-items:center;gap:11px;margin:0 0 12px'>"
        f"<span style='width:4px;height:18px;background:{accent};border-radius:2px;"
        f"box-shadow:0 0 10px {accent}cc'></span>"
        f"<span style='font-size:13px;font-weight:950;color:#101726;letter-spacing:1.4px;"
        f"text-transform:uppercase'>{html.escape(label)}</span>{sub_html}</div>"
    )

def _ge_rank_badge(rank: int, pct: int, accent: str) -> str:
    """우상단 OVR식 순위 배지 — 큰 숫자 + 글로우."""
    return (
        "<div style='text-align:center;flex:none;line-height:1'>"
        f"<div style='font-size:26px;font-weight:950;color:{accent};letter-spacing:-1px;"
        f"text-shadow:0 0 14px {accent}88'>{rank}<span style='font-size:12px'>위</span></div>"
        f"<div style='font-size:8.5px;font-weight:900;color:{_GE_MUT};letter-spacing:1px;"
        f"margin-top:2px'>P{pct}</div></div>"
    )


def _factor_rank_text(df: pd.DataFrame, team: str, col: str) -> tuple[int, int, float]:
    return _clean_rank(df, team, col) if col in getattr(df, "columns", []) else (10, 50, 50.0)


# 팩터별 헤드라인 지표 → (한글 라벨, 소수자리, 단위). 동적 진단 문구에 쓰인다.
_HEAD_LABEL = {
    "key_passes_per90": ("키패스", 1, "/90"),
    "big_chances_created_per90": ("빅찬스", 1, "/90"),
    "final_third_passes_per90": ("전진패스", 1, "/90"),
    "successful_dribbles_per90": ("드리블", 1, "/90"),
    "npg_per90": ("논PK골", 2, "/90"),
    "sh_per90": ("슈팅", 1, "/90"),
    "possession_won_att_per90": ("전방 탈환", 1, "/90"),
    "recoveries_per90": ("볼 회수", 1, "/90"),
    "aerial_won_per90": ("공중볼 승", 1, "/90"),
    "tackles_won_per90_ss": ("태클 성공", 1, "/90"),
    "fouls_per90": ("파울", 1, "/90"),
    "clearances_per90": ("클리어", 1, "/90"),
}


def _player_value(team: str, full_df: pd.DataFrame, player: str, col: str) -> float | None:
    """특정 선수의 단일 지표 원본값 — 동적 진단의 스탯 클로즈에 사용."""
    if full_df is None or full_df.empty or col not in full_df.columns:
        return None
    if not {"player", "squad"} <= set(full_df.columns):
        return None
    sq = full_df[(full_df["squad"].astype(str) == team) & (full_df["player"].astype(str) == player)]
    if sq.empty:
        return None
    v = pd.to_numeric(sq[col], errors="coerce").dropna()
    return float(v.iloc[0]) if not v.empty else None


def _factor_verdict(spec: dict, leaders: list[tuple[str, float]], gaps: list[tuple[str, float]],
                    team: str, full_df: pd.DataFrame, sb_line: str = "") -> str:
    """팀 순위·핵심 기여 선수·실제 스탯을 엮은 한 줄 동적 진단."""
    rank = spec["rank"]
    if rank <= 3:
        stand = f"리그 {rank}위 핵심 강점"
    elif rank <= 7:
        stand = f"리그 {rank}위 상위권 강점"
    elif rank >= 17:
        stand = f"리그 {rank}위 최하위권 약점"
    elif rank >= 14:
        stand = f"리그 {rank}위 하위권 약점"
    else:
        stand = f"리그 {rank}위 중위권"

    if not leaders:
        return f"{stand} · 핵심 기여자 데이터 확인 필요"

    lead_full = leaders[0][0]
    lead = lead_full.split()[-1] if lead_full else ""
    head_col = spec["metrics"][0]
    label, dec, unit = _HEAD_LABEL.get(head_col, ("", 1, ""))
    val = _player_value(team, full_df, lead_full, head_col)
    if val is not None and label:
        stat = f"{lead} {label} {val:.{dec}f}{unit}"
    else:
        stat = f"{lead} 중심"

    # 세트피스는 팀 단위 득점 근거(코너/세트피스 골)를 우선 노출
    if spec["key"] == "setpiece" and sb_line:
        return f"{stand} · {sb_line}"
    if rank >= 14:
        weak = gaps[0][0].split()[-1] if gaps else ""
        tail = f", {weak} 보강 검토" if weak else ", 보강 검토"
        return f"{stand} · {stat} 의존{tail}"
    return f"{stand} · {stat}"


def _build_match_factor_cards(team: str, df: pd.DataFrame, full_df: pd.DataFrame,
                              statbunker: pd.DataFrame | None) -> str:
    specs = [
        {
            "key": "setpiece",
            "title": "세트피스 무기",
            "col": "set_piece_attack_index",
            "tone": "#7c3aed",
            "metrics": ["key_passes_per90", "big_chances_created_per90", "final_third_passes_per90"],
            "gap_metrics": ["aerial_won_per90", "aerial_won_pct"],
            "why": "데드볼 공급과 박스 타깃 연결이 득점 루트로 이어지는지 확인합니다.",
        },
        {
            "key": "creation",
            "title": "찬스 생성 엔진",
            "col": "midfield_creativity_index",
            "tone": "#ef4444",
            "metrics": ["key_passes_per90", "big_chances_created_per90", "successful_dribbles_per90"],
            "gap_metrics": ["key_passes_per90", "big_chances_created_per90"],
            "why": "오픈플레이에서 박스 진입 패스와 마지막 패스가 누구에게서 나오는지 봅니다.",
        },
        {
            "key": "pressing",
            "title": "압박/볼 회수",
            "col": "pressing_index",
            "tone": "#f97316",
            "metrics": ["possession_won_att_per90", "recoveries_per90", "tackles_won_per90_ss"],
            "gap_metrics": ["possession_won_att_per90", "recoveries_per90", "tackles_won_per90_ss"],
            "why": "전방 압박이 실제 회수와 역습 차단으로 이어지는지 추적합니다.",
        },
        {
            "key": "box_defense",
            "title": "박스 방어/공중전",
            "col": "defense_box_aerial_index",
            "tone": "#2563eb",
            "metrics": ["aerial_won_per90", "clearances_per90", "blocked_shots_per90"],
            "gap_metrics": ["aerial_won_per90", "clearances_per90", "blocked_shots_per90"],
            "why": "크로스, 세컨볼, 박스 안 슈팅을 누가 지우는지 확인합니다.",
        },
        {
            "key": "finishing",
            "title": "득점 마무리",
            "col": "attack_output_index",
            "tone": "#d97706",
            "metrics": ["npg_per90", "sh_per90", "npxg_p90"],
            "gap_metrics": ["npxg_p90", "sh_per90"],
            "why": "만들어진 슈팅 기회를 실제 득점으로 끝내는 박스 안 마무리 효율을 봅니다.",
        },
        {
            "key": "progression",
            "title": "전진/빌드업",
            "col": "midfield_control_index",
            "tone": "#0d9488",
            "metrics": ["final_third_passes_per90", "key_passes_per90", "successful_dribbles_per90"],
            "gap_metrics": ["final_third_passes_per90", "key_passes_per90"],
            "why": "후방 빌드업에서 전진 패스와 3선 침투가 누구를 통해 나오는지 추적합니다.",
        },
        {
            "key": "disruption",
            "title": "전환 차단",
            "col": "defense_disruption_index",
            "tone": "#4f46e5",
            "metrics": ["tackles_won_per90_ss", "interceptions_per90_ss", "outfielder_blocks_per90"],
            "gap_metrics": ["tackles_won_per90_ss", "interceptions_per90_ss", "outfielder_blocks_per90"],
            "why": "상대 역습을 끊는 태클·인터셉트·차단이 수비 라인 전반에서 나오는지 봅니다.",
        },
        {
            "key": "ball_winning",
            "title": "볼 회수/탈환",
            "col": "midfield_ball_winning_index",
            "tone": "#db2777",
            "metrics": ["recoveries_per90", "possession_won_att_per90", "ground_duels_won_per90"],
            "gap_metrics": ["recoveries_per90", "ground_duels_won_per90"],
            "why": "느슨한 볼과 세컨볼을 되찾아 점유를 회복하는 힘이 누구에게서 나오는지 봅니다.",
        },
        {
            "key": "discipline",
            "title": "경기 관리",
            "col": "discipline_index",
            "tone": "#16a34a",
            "metrics": ["fouls_per90", "fouled_per90", "errors_per90"],
            "gap_metrics": ["fouls_per90", "errors_per90"],
            "why": "파울, 카드 리스크, 불필요한 실수가 경기 운영에 주는 영향을 봅니다.",
        },
    ]

    tcol = team_color(team)
    pmap = {}
    if full_df is not None and not full_df.empty and {"player", "squad"} <= set(full_df.columns):
        ft = full_df[full_df["squad"].astype(str) == team]
        for _, r in ft.iterrows():
            pmap[str(r["player"])] = _photo(r.get("sofa_id"), r.get("tm_photo"))

    # 전 팩터 랭크 계산 → 강점(왼쪽)·약점(오른쪽)으로 분리
    ranked = []
    for spec in specs:
        rank, pct, score = _factor_rank_text(df, team, spec["col"])
        ranked.append({**spec, "rank": rank, "pct": pct, "score": score})
    ranked.sort(key=lambda s: s["rank"])
    strengths = ranked[:3]                 # 가장 강한 3개
    risks = list(reversed(ranked[-3:]))    # 가장 약한 3개(약한 순)

    def make_card(spec: dict) -> str:
        leaders = _player_metric_leaders(team, full_df, spec["metrics"])
        gaps = _player_metric_gaps(team, full_df, spec["gap_metrics"])
        status = "강점" if spec["rank"] <= 7 else ("리스크" if spec["rank"] >= 14 else "관찰")
        sb_line = ""
        if spec["key"] == "setpiece" and statbunker is not None:
            sb_df = statbunker.copy()
            if "squad" in sb_df.columns:
                sb_df = sb_df.set_index("squad")
            if team in sb_df.index:
                sb = sb_df.loc[team]
                corner = int(pd.to_numeric(sb.get("corner_goals", 0), errors="coerce") or 0)
                set_piece = int(pd.to_numeric(sb.get("non_penalty_set_piece_goals", 0), errors="coerce") or 0)
                sb_line = f"코너 득점 {corner}골 · 비PK 세트피스 {set_piece}골"
        verdict = _factor_verdict(spec, leaders, gaps, team, full_df, sb_line)
        tone = spec["tone"]
        return (
            f"<div style='{_ge_panel_style(tone)};padding:14px 16px'>"
            # 상단: 상태 태그 + OVR식 순위 배지
            "<div style='display:flex;justify-content:space-between;align-items:flex-start;gap:8px'>"
            "<div>"
            f"<div style='font-size:9px;font-weight:950;color:{tone};letter-spacing:1.3px;"
            f"text-transform:uppercase'>{status} FACTOR</div>"
            f"<div style='font-size:17px;font-weight:950;color:{_GE_TXT};margin-top:5px;"
            f"text-shadow:0 0 18px {tone}40'>{html.escape(spec['title'])}</div></div>"
            f"{_ge_rank_badge(spec['rank'], spec['pct'], tone)}</div>"
            # 동적 진단(네온) + 설명
            f"<div style='font-size:12px;font-weight:800;color:{tone};line-height:1.4;margin-top:11px'>{html.escape(verdict)}</div>"
            f"<div style='font-size:10.5px;color:{_GE_SUB};line-height:1.45;margin-top:5px'>{html.escape(spec['why'])}</div>"
            # 기여/보완 선수 — 다크 미니 패널
            "<div style='display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:13px'>"
            f"<div style='background:rgba(255,255,255,.03);border:1px solid {_GE_LINE};border-radius:6px;padding:9px 10px'>"
            f"<div style='font-size:9px;font-weight:950;color:{_GE_MUT};letter-spacing:.7px'>▲ 기여 선수</div>"
            f"{_player_chips(leaders, pmap, tcol, dark=True)}"
            "</div>"
            f"<div style='background:rgba(248,113,113,.06);border:1px solid rgba(248,113,113,.20);border-radius:6px;padding:9px 10px'>"
            "<div style='font-size:9px;font-weight:950;color:#fca5a5;letter-spacing:.7px'>▽ 보완 관찰</div>"
            f"{_player_chips(gaps, pmap, tcol, dark=True)}"
            "</div></div>"
            "</div>"
        )

    def column(title: str, accent: str, items: list[dict]) -> str:
        head = (
            "<div style='display:flex;align-items:center;gap:8px;margin-bottom:11px'>"
            f"<span style='width:4px;height:15px;background:{accent};border-radius:2px;"
            f"box-shadow:0 0 9px {accent}cc'></span>"
            f"<span style='font-size:11.5px;font-weight:950;color:{accent};letter-spacing:1.1px;"
            f"text-transform:uppercase'>{title}</span></div>"
        )
        body = ("<div style='display:flex;flex-direction:column;gap:12px'>"
                + "".join(make_card(s) for s in items) + "</div>")
        return f"<div>{head}{body}</div>"

    return (
        "<div style='background:radial-gradient(120% 80% at 0% 0%,#0e1626,#0a0f1a);"
        "border:1px solid rgba(125,145,185,.14);border-radius:14px;padding:16px 16px 18px;"
        "box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 10px 30px rgba(0,0,0,.28)'>"
        "<div style='display:grid;grid-template-columns:1fr 1fr;gap:16px'>"
        f"{column('강점 팩터', '#3ddc84', strengths)}"
        f"{column('보강 검토 팩터', '#f87171', risks)}"
        "</div></div>"
    )


# ── Recruitment Impact Audit ─────────────────────────────────────────────────
def _audit_norm(value) -> str:
    return unidecode(str(value or "")).lower().strip()


def _audit_season_label(value) -> str:
    try:
        sid = int(float(value))
        return f"{sid % 100:02d}/{(sid + 1) % 100:02d}"
    except Exception:
        return str(value or "Season")


def _audit_stats_season(full_df: pd.DataFrame) -> int | None:
    if "season_id" in full_df.columns and full_df["season_id"].notna().any():
        return int(float(full_df["season_id"].dropna().max()))
    # The current performance tables are 2025/26 snapshots and do not carry
    # season_id yet. Avoid projecting those minutes onto future transfer rows.
    return 2025


def _impact_star_html(stars: float, tone: str, empty_color: str = "#cbd5e1") -> str:
    full = int(stars)
    half = abs(stars - full - 0.5) < 0.01
    empty = max(0, 5 - full - (1 if half else 0))
    half_html = (
        f"<span style='position:relative;display:inline-block;color:{empty_color}'>★"
        f"<span style='position:absolute;left:0;top:0;width:50%;overflow:hidden;color:{tone}'>★</span></span>"
        if half else ""
    )
    return (
        "<div style='display:flex;align-items:center;gap:7px;margin-top:10px'>"
        f"<div style='font-size:18px;letter-spacing:1px;line-height:1;text-shadow:0 0 10px {tone}55'>"
        f"<span style='color:{tone}'>{'★' * full}</span>{half_html}"
        f"<span style='color:{empty_color}'>{'★' * empty}</span></div>"
        f"<div style='font-size:11px;font-weight:950;color:{tone}'>{stars:.1f}/5</div>"
        "</div>"
    )


def _impact_status(row: pd.Series, fee_eur: float) -> tuple[str, str, str, float, list[str]]:
    rating = float(pd.to_numeric(row.get("ss_rating", 0), errors="coerce") or 0)
    minutes = float(pd.to_numeric(row.get("minutes", 0), errors="coerce") or 0)
    goals = float(pd.to_numeric(row.get("goals", 0), errors="coerce") or 0)
    assists = float(pd.to_numeric(row.get("assists", 0), errors="coerce") or 0)
    npxg = float(pd.to_numeric(row.get("npxg_p90", 0), errors="coerce") or 0)
    xa = float(pd.to_numeric(row.get("xa_p90", 0), errors="coerce") or 0)
    kp = float(pd.to_numeric(row.get("key_passes_per90", 0), errors="coerce") or 0)
    press = float(pd.to_numeric(row.get("possession_won_att_per90", 0), errors="coerce") or 0)
    recoveries = float(pd.to_numeric(row.get("recoveries_per90", 0), errors="coerce") or 0)
    tackles = float(pd.to_numeric(row.get("tackles_won_per90_ss", 0), errors="coerce") or 0)
    interceptions = float(pd.to_numeric(row.get("interceptions_per90_ss", 0), errors="coerce") or 0)
    clearances = float(pd.to_numeric(row.get("clearances_per90", 0), errors="coerce") or 0)
    aerial = float(pd.to_numeric(row.get("aerial_won_per90", 0), errors="coerce") or 0)
    final_third = float(pd.to_numeric(row.get("final_third_passes_per90", 0), errors="coerce") or 0)
    save_pct = float(pd.to_numeric(row.get("gk_save_pct", 0), errors="coerce") or 0)
    cs_pct = float(pd.to_numeric(row.get("gk_cs_pct", 0), errors="coerce") or 0)
    clean_sheets = float(pd.to_numeric(row.get("gk_clean_sheets", 0), errors="coerce") or 0)
    ga = goals + assists
    premium = fee_eur >= 60_000_000
    fee_band = "프리미엄 이적료" if premium else ("주전급 비용" if fee_eur >= 30_000_000 else ("저비용 영입" if fee_eur > 0 else "임대/자유계약"))
    group = str(row.get("fl_group") or row.get("fl_pos") or _line_of(row.get("tm_position") or row.get("pos"))).upper()

    score = rating
    if group == "GK":
        score += min(0.35, max(0, save_pct - 65) / 35)
        score += min(0.22, cs_pct / 260)
        score += min(0.10, clean_sheets / 80)
        metric_line = f"GK 핵심: 선방률 {save_pct:.1f}% · 클린시트 {int(clean_sheets)}회"
        support_line = f"안정성: CS% {cs_pct:.1f}% · 출전 {int(minutes)}분"
    elif group in ("CB", "LB", "RB", "LWB", "RWB", "DF"):
        score += min(0.30, clearances * 0.045 + aerial * 0.055)
        score += min(0.22, interceptions * 0.08 + tackles * 0.07)
        score += min(0.12, final_third * 0.006)
        metric_line = f"수비 핵심: 클리어 {clearances:.1f}/90 · 공중볼 {aerial:.1f}/90"
        support_line = f"전진/차단: 인터셉트 {interceptions:.1f}/90 · 전진패스 {final_third:.1f}/90"
    elif group in ("DM", "CM", "MF"):
        score += min(0.30, recoveries * 0.04 + tackles * 0.06 + interceptions * 0.07)
        score += min(0.20, final_third * 0.007 + kp * 0.035)
        score += min(0.12, press * 0.05)
        metric_line = f"중원 핵심: 회수 {recoveries:.1f}/90 · 태클 {tackles:.1f}/90"
        support_line = f"전개/압박: 전진패스 {final_third:.1f}/90 · 탈환 {press:.1f}/90"
    else:
        score += min(0.45, ga / 28)
        score += min(0.24, npxg * 0.25 + xa * 0.25)
        score += min(0.18, kp * 0.04 + press * 0.05)
        metric_line = f"공격 핵심: G+A {int(ga)} · npxG+xA/90 {(npxg + xa):.2f}"
        support_line = f"창출/압박: KP {kp:.1f}/90 · 탈환 {press:.1f}/90"
    fee_pressure = 0.0
    if fee_eur >= 120_000_000:
        fee_pressure = 1.15
    elif fee_eur >= 80_000_000:
        fee_pressure = 0.85
    elif fee_eur >= 50_000_000:
        fee_pressure = 0.55
    elif fee_eur >= 25_000_000:
        fee_pressure = 0.25

    rating_stars = 1.0 + max(0.0, min(1.0, (rating - 6.25) / 1.15)) * 4.0
    if group == "GK":
        role_bonus = min(0.85, max(0.0, (save_pct - 66) / 18) + cs_pct / 260)
    elif group in ("CB", "LB", "RB", "LWB", "RWB", "DF"):
        role_bonus = min(0.75, clearances * 0.045 + aerial * 0.055 + interceptions * 0.07 + tackles * 0.05)
    elif group in ("DM", "CM", "MF"):
        role_bonus = min(0.75, recoveries * 0.045 + tackles * 0.055 + interceptions * 0.065 + final_third * 0.006 + kp * 0.03)
    else:
        ga_per90 = ga / max(minutes / 90.0, 1.0)
        role_bonus = min(0.95, ga_per90 * 0.72 + (npxg + xa) * 0.35 + kp * 0.06)

    sample_penalty = 0.45 if minutes < 900 else (0.20 if minutes < 1500 else 0.0)
    stars_raw = rating_stars + role_bonus - fee_pressure - sample_penalty
    stars = round(max(1.0, min(5.0, stars_raw)) * 2) / 2

    if fee_eur >= 100_000_000 and rating < 6.75:
        stars = min(stars, 2.0)
    elif fee_eur >= 100_000_000 and rating < 6.95:
        stars = min(stars, 3.0)
    elif fee_eur >= 60_000_000 and rating < 6.85:
        stars = min(stars, 3.0)

    evidence = [
        f"{fee_band} 기준 · 평점 {rating:.2f} · 출전 {int(minutes)}분",
        metric_line,
        support_line,
    ]
    if stars <= 2.0:
        return "기대 이하", "#ef4444", "이적료 규모에 비해 경기 영향이 아직 충분하지 않습니다.", stars, evidence
    if minutes < 600:
        return "판단 보류", "#d97706", "출전 표본이 작아 적응 맥락까지 같이 봐야 합니다.", stars, evidence
    if stars >= 4.0:
        return "기대치 충족", "#16a34a", "성과와 과정 지표가 이적료 기대치에 근접합니다.", stars, evidence
    if stars >= 3.0:
        return "적응 구간", "#d97706", "결과는 일부 나오지만 세부 기여가 더 올라와야 합니다.", stars, evidence
    return "미달 신호", "#ef4444", "비용 대비 즉시 전력감으로는 근거가 부족합니다.", stars, evidence


def _recruitment_audit_html(team: str, transfers: pd.DataFrame | None,
                            full_df: pd.DataFrame, color: str) -> str:
    if transfers is None or transfers.empty or "squad" not in transfers.columns:
        return ""
    ins = transfers[
        (transfers["squad"].astype(str) == team)
        & (transfers["direction"].astype(str).str.lower() == "in")
    ].copy()
    if "window" in ins.columns:
        summer = ins["window"].astype(str).str.lower().eq("summer")
        if summer.any():
            ins = ins[summer].copy()
    if ins.empty:
        return ""
    ins["fee_eur_num"] = pd.to_numeric(ins.get("fee_eur"), errors="coerce").fillna(0)
    ins["paid_sort"] = (ins["fee_eur_num"] > 0).astype(int)
    ins = ins.sort_values(["paid_sort", "fee_eur_num", "player"], ascending=[False, False, True])
    if ins.empty:
        return ""

    full = full_df.copy()
    full["_audit_norm"] = full["player"].map(_audit_norm) if "player" in full.columns else ""
    full_team = full[full["squad"].astype(str) == team] if "squad" in full.columns else full
    stats_season = _audit_stats_season(full_df)

    def played_transfer_match(norm_key: str) -> pd.DataFrame:
        if full_team.empty or "_audit_norm" not in full_team.columns:
            return pd.DataFrame()
        match_df = full_team[full_team["_audit_norm"] == norm_key]
        if match_df.empty and norm_key:
            match_df = full_team[full_team["_audit_norm"].str.contains(norm_key, regex=False, na=False)]
        return match_df

    def build_transfer_card(tr: pd.Series):
        transfer_season = pd.to_numeric(tr.get("season_id"), errors="coerce")
        key = _audit_norm(tr.get("norm_key") or tr.get("player"))
        player = str(tr.get("player", "Unknown"))
        fee_text = str(tr.get("fee_text") or "").strip()
        if not fee_text or fee_text.lower() == "nan":
            fee_text = "undisclosed"
        fee_text_l = fee_text.lower()
        if "end of loan" in fee_text_l or "loan return" in fee_text_l or "return from loan" in fee_text_l:
            return None
        pos = str(tr.get("pos") or "")
        fee = float(tr.get("fee_eur_num", 0))
        future_season = stats_season is not None and pd.notna(transfer_season) and int(transfer_season) != stats_season
        if future_season:
            tone = "#64748b"
            season_label = _audit_season_label(transfer_season)
            evidence = [
                f"{season_label} 신규 등록 · 출전 전",
                f"영입 형태: {fee_text}",
                "초기 출전 흐름과 역할을 우선 관찰",
            ]
            evidence_html = "".join(
                f"<div style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>{html.escape(line)}</div>"
                for line in evidence
            )
            photo = _photo("", tr.get("photo") or tr.get("tm_photo"))
            card = (
                f"<div style='{_ge_panel_style(tone, 14)};padding:14px 15px'>"
                "<div style='display:flex;align-items:center;gap:11px'>"
                f"{avatar(photo, tone, 46, 'flex:none')}"
                "<div style='flex:1;min-width:0'>"
                f"<div style='font-size:16px;font-weight:950;color:{_GE_TXT};white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>{html.escape(player)}</div>"
                f"<div style='font-size:11px;color:{_GE_MUT};margin-top:2px'>{html.escape(pos)}</div></div>"
                f"<div style='font-size:10px;font-weight:950;color:{_GE_TXT};background:{tone}22;border:1px solid {tone}55;"
                f"border-radius:5px;padding:3px 8px;flex:none'>{html.escape(fee_text)}</div></div>"
                f"<div style='font-size:9.5px;font-weight:950;color:{tone};letter-spacing:1.2px;margin-top:11px;"
                f"text-transform:uppercase'>관찰 대상</div>"
                f"<div style='display:flex;align-items:center;gap:7px;margin-top:9px'>"
                f"<div style='font-size:18px;letter-spacing:1px;color:#39435a;line-height:1'>☆☆☆☆☆</div>"
                f"<div style='font-size:11px;font-weight:950;color:{tone}'>출전 전</div></div>"
                f"<div style='font-size:12px;font-weight:900;color:{_GE_TXT};line-height:1.4;margin-top:7px'>아직 공식 경기 표본 없음</div>"
                f"<div style='font-size:11px;color:{_GE_SUB};line-height:1.42;margin-top:5px'>초기 기용 방식과 역할 적합성을 먼저 확인합니다.</div>"
                f"<div style='font-size:10.5px;color:{_GE_MUT};line-height:1.5;margin-top:7px'>{evidence_html}</div>"
                "</div>"
            )
            return card, tone
        age = pd.to_numeric(tr.get("age"), errors="coerce")
        age = float(age) if pd.notna(age) else 99.0
        match = played_transfer_match(key)
        if match.empty:
            return None
        row = match.iloc[0]
        minutes = int(pd.to_numeric(row.get("minutes", 0), errors="coerce") or 0)
        if minutes < 300 or (age < 20 and minutes < 900):
            return None
        status, tone, note, stars, evidence = _impact_status(row, fee)
        goals = int(pd.to_numeric(row.get("goals", 0), errors="coerce") or 0)
        assists = int(pd.to_numeric(row.get("assists", 0), errors="coerce") or 0)
        rating = float(pd.to_numeric(row.get("ss_rating", 0), errors="coerce") or 0)
        stat_line = f"{minutes}분 · {goals}골 {assists}도움 · 평점 {rating:.2f}"
        photo = _photo(row.get("sofa_id"), row.get("tm_photo"))
        evidence_html = "".join(
            f"<div style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>{html.escape(line)}</div>"
            for line in evidence[:3]
        )
        card = (
            f"<div style='{_ge_panel_style(tone, 14)};padding:14px 15px'>"
            "<div style='display:flex;align-items:center;gap:11px'>"
            f"{avatar(photo, tone, 46, 'flex:none')}"
            "<div style='flex:1;min-width:0'>"
            f"<div style='font-size:16px;font-weight:950;color:{_GE_TXT};white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>{html.escape(player)}</div>"
            f"<div style='font-size:11px;color:{_GE_MUT};margin-top:2px'>{html.escape(pos)}</div></div>"
            f"<div style='font-size:10px;font-weight:950;color:{_GE_TXT};background:{tone}22;border:1px solid {tone}55;"
            f"border-radius:5px;padding:3px 8px;flex:none'>{html.escape(fee_text)}</div></div>"
            f"<div style='font-size:9.5px;font-weight:950;color:{tone};letter-spacing:1.2px;margin-top:11px;"
            f"text-transform:uppercase'>{html.escape(status)}</div>"
            f"{_impact_star_html(stars, tone, empty_color='#39435a')}"
            f"<div style='font-size:12px;font-weight:900;color:{_GE_TXT};line-height:1.4;margin-top:7px'>{html.escape(stat_line)}</div>"
            f"<div style='font-size:11px;color:{_GE_SUB};line-height:1.42;margin-top:5px'>{html.escape(note)}</div>"
            f"<div style='font-size:10.5px;color:{_GE_MUT};line-height:1.5;margin-top:7px'>{evidence_html}</div>"
            "</div>"
        )
        return card, tone

    season_values = [None]
    if "season_id" in ins.columns and ins["season_id"].notna().any():
        season_values = sorted(ins["season_id"].dropna().unique(), reverse=True)

    season_groups = []
    total_cards = 0
    summary = {"green": 0, "amber": 0, "red": 0}
    for season_value in season_values:
        season_ins = ins
        if season_value is not None and "season_id" in ins.columns:
            season_ins = ins[ins["season_id"] == season_value].copy()

        cards = []
        for _, tr in season_ins.iterrows():
            built = build_transfer_card(tr)
            if built is None:
                continue
            card, tone = built
            cards.append(card)
            if tone == "#16a34a":
                summary["green"] += 1
            elif tone == "#ef4444":
                summary["red"] += 1
            elif tone != "#64748b":
                summary["amber"] += 1

        if not cards:
            continue

        total_cards += len(cards)
        season_label = _audit_season_label(season_value) if season_value is not None else "현재 시즌"
        season_groups.append(
            "<div style='border:1px solid rgba(125,145,185,.14);border-radius:10px;padding:13px 14px;margin-top:12px;"
            "background:rgba(255,255,255,.02)'>"
            "<div style='display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:11px'>"
            f"<div style='font-size:14px;font-weight:950;color:{_GE_TXT};letter-spacing:.5px'>"
            f"<span style='color:#22d3ee'>▸</span> {html.escape(season_label)} 시즌 영입 리포트</div>"
            f"<div style='font-size:11px;font-weight:950;color:#22d3ee;background:rgba(34,211,238,.12);"
            f"border:1px solid rgba(34,211,238,.32);border-radius:5px;padding:4px 10px'>{len(cards)}명</div></div>"
            f"<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:14px'>{''.join(cards)}</div>"
            "</div>"
        )

    if not season_groups:
        return ""

    verdict = "아직 단정하기보다 출전 흐름을 더 지켜볼 구간입니다."
    if summary["red"] >= 2:
        verdict = "비용 대비 즉시 영향이 약한 영입이 있어 역할 재점검이 필요합니다."
    elif summary["green"] >= 2:
        verdict = "주요 영입들이 팀의 경기 강점을 안정적으로 이어가고 있습니다."
    elif summary["amber"] >= 2:
        verdict = "적응 중인 선수가 많아 기용 방식과 역할 선명도가 중요합니다."

    return (
        f"{_ge_section_title('Recruitment Impact Audit', '영입 리포트', '#fb923c')}"
        "<div style='background:radial-gradient(120% 80% at 100% 0%,#0e1626,#0a0f1a);"
        "border:1px solid rgba(125,145,185,.14);border-radius:14px;padding:16px 18px;"
        "box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 10px 30px rgba(0,0,0,.28);margin-bottom:16px'>"
        "<div style='display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:8px'>"
        f"<div style='font-size:12px;color:{_GE_SUB}'>출전 기록과 이적료 규모를 함께 본 시즌별 영입 리포트</div>"
        f"<div style='font-size:12px;font-weight:900;color:#fbbf24;text-align:right;max-width:420px'>{html.escape(verdict)}</div></div>"
        f"<div style='font-size:11px;color:{_GE_MUT};margin:0 0 4px'>출전 300분 이상 {total_cards}명 기준 · 10대 유망주는 충분히 뛴 뒤 반영</div>"
        f"{''.join(season_groups)}"
        "</div>"
    )


# ── Injury impact ────────────────────────────────────────────────────────────
_LINE_LABEL = {"GK": "골키퍼", "DF": "수비", "MF": "중원", "FW": "공격"}
_LINE_TONE = {"GK": "#0891b2", "DF": "#2563eb", "MF": "#16a34a", "FW": "#ef4444"}
_LINE_ORDER = {"DF": 0, "MF": 1, "FW": 2, "GK": 3}


def _line_of(pos) -> str:
    """FBref(pos) · Transfermarkt(position) 문자열 → 라인(GK/DF/MF/FW)."""
    p = str(pos or "").lower().strip()
    if not p:
        return "MF"
    if "goal" in p or p == "gk":
        return "GK"
    if "midfield" in p or p in ("mf", "dm", "cm", "am", "cdm", "cam"):
        return "MF"
    if "back" in p or "defender" in p or p in ("df", "cb", "rb", "lb", "rwb", "lwb"):
        return "DF"
    if "wing" in p or "forward" in p or "striker" in p or p in ("fw", "st", "cf", "rw", "lw"):
        return "FW"
    token = p.split(",")[0].strip().upper()
    return {"GK": "GK", "DF": "DF", "MF": "MF", "FW": "FW"}.get(token, "MF")


# 라인별 시그니처 스탯 후보 — (컬럼, 라벨, 종류, 기준값). 기준 대비 가장 두드러진 항목을 고른다.
#   종류: pct=정확도/비율(%), rate=경기당(소수1), rate2=경기당(소수2), goals/assists=시즌 합계
_SIG_BY_LINE = {
    "GK": [("gk_save_pct", "선방률", "pct", 66.0), ("gk_cs_pct", "클린시트율", "pct", 30.0)],
    "DF": [("aerial_won_pct", "공중 경합 승률", "pct", 55.0), ("tackles_won_per90_ss", "태클 성공", "rate", 1.0),
           ("interceptions_per90_ss", "인터셉트", "rate", 0.8), ("clearances_per90", "클리어", "rate", 3.0),
           ("pass_pct", "패스 정확도", "pct", 85.0)],
    "MF": [("pass_pct", "패스 정확도", "pct", 85.0), ("key_passes_per90", "키패스", "rate", 1.2),
           ("big_chances_created_per90", "빅찬스 창출", "rate2", 0.25), ("successful_dribbles_per90", "드리블 성공", "rate", 1.2),
           ("tackles_won_per90_ss", "태클 성공", "rate", 1.3), ("recoveries_per90", "볼 회수", "rate", 6.5)],
    "FW": [("goals", "리그", "goals", 6.0), ("npxg_p90", "npxG", "rate2", 0.4), ("sh_per90", "슈팅", "rate", 2.5),
           ("assists", "도움", "assists", 4.0), ("successful_dribbles_per90", "드리블 성공", "rate", 1.5),
           ("key_passes_per90", "키패스", "rate", 1.2)],
}


def _signature_stat(s, line: str) -> str:
    """선수의 라인 기준 가장 두드러진 대표 스탯 한 줄(예: '패스 정확도 90%', '리그 14골')."""
    if s is None:
        return ""
    best = None  # (기준 대비 배수, 문구)
    for col, label, kind, thr in _SIG_BY_LINE.get(line, _SIG_BY_LINE["MF"]):
        v = pd.to_numeric(s.get(col), errors="coerce")
        if pd.isna(v) or float(v) <= 0:
            continue
        v = float(v)
        if kind == "pct":
            phrase = f"{label} {v:.0f}%"
        elif kind == "rate":
            phrase = f"{label} {v:.1f}/90"
        elif kind == "rate2":
            phrase = f"{label} {v:.2f}/90"
        elif kind == "goals":
            phrase = f"{int(round(v))}골"
        elif kind == "assists":
            phrase = f"{int(round(v))}도움"
        else:
            phrase = f"{label} {v:.1f}"
        imp = v / thr
        if best is None or imp > best[0]:
            best = (imp, phrase)
    return best[1] if best else ""


def _fmt_inj_date(value) -> str:
    """'18/08/2025' → '25.08.18'. 진행 중('?') 등은 원문 유지."""
    parts = str(value or "").strip().split("/")
    if len(parts) == 3 and all(p.isdigit() for p in parts):
        d, m, y = parts
        return f"{y[2:]}.{m}.{d}"
    return str(value or "").strip() or "—"


def _injury_impact_html(team: str, inj_hist: pd.DataFrame | None,
                        full_df: pd.DataFrame, color: str) -> str:
    """시즌 부상 결장(전 대회 기준 games missed) → 라인별 전력 공백.
    약화 지표 = 결장 경기수 × 기여 가중(시즌 출전분)."""
    if inj_hist is None or inj_hist.empty or "squad" not in inj_hist.columns:
        return ""
    inj = inj_hist[inj_hist["squad"].astype(str) == team].copy()
    if inj.empty:
        return ""
    inj["__gm"] = pd.to_numeric(inj.get("games_missed"), errors="coerce").fillna(0).astype(int)
    inj = inj[inj["__gm"] > 0]
    if inj.empty:
        return ""

    sq = full_df[full_df["squad"].astype(str) == team].copy() if "squad" in getattr(full_df, "columns", []) else pd.DataFrame()
    if not sq.empty and "player" in sq.columns:
        sq["_n"] = sq["player"].map(_audit_norm)

    line_score = {"GK": 0.0, "DF": 0.0, "MF": 0.0, "FW": 0.0}
    line_count = {"GK": 0, "DF": 0, "MF": 0, "FW": 0}
    rows = []
    for _, ir in inj.iterrows():
        name = str(ir.get("player", ""))
        gm = int(ir["__gm"])
        spells = int(pd.to_numeric(ir.get("spells"), errors="coerce") or 0)
        injuries = str(ir.get("injuries") or "부상")
        try:
            spell_list = json.loads(str(ir.get("spells_json") or "[]"))
        except (ValueError, TypeError):
            spell_list = []
        spell_list = sorted(spell_list, key=lambda s: int(s.get("games") or 0), reverse=True)
        minutes = goals = assists = 0
        rating = 0.0
        pos = ""
        photo = ""
        mv = 0.0
        match_row = None
        if not sq.empty:
            m = sq[sq["_n"] == _audit_norm(name)]
            if not m.empty:
                mr = m.iloc[0]
                match_row = mr
                minutes = int(pd.to_numeric(mr.get("minutes"), errors="coerce") or 0)
                goals = int(pd.to_numeric(mr.get("goals"), errors="coerce") or 0)
                assists = int(pd.to_numeric(mr.get("assists"), errors="coerce") or 0)
                rating = float(pd.to_numeric(mr.get("ss_rating"), errors="coerce") or 0)
                pos = str(mr.get("pos") or "")
                photo = _photo(mr.get("sofa_id"), mr.get("tm_photo"))
                mv = float(pd.to_numeric(mr.get("market_value_eur"), errors="coerce") or 0)
        line = _line_of(pos)
        # 기여 가중 = 시장가치(€60m=1.0). 출전분이 아닌 가치로 가중해야
        # '시즌 내내 부상→출전분 적음→과소평가' 순환을 피한다.
        weight = max(0.15, min(1.6, mv / 60_000_000.0))
        score = gm * weight
        line_score[line] += score
        line_count[line] += 1
        rows.append({
            "name": name, "photo": photo, "line": line, "pos": pos,
            "gm": gm, "spells": spells, "injuries": injuries, "spell_list": spell_list,
            "minutes": minutes, "goals": goals, "assists": assists,
            "rating": rating, "score": score, "mv": mv,
            "sig": _signature_stat(match_row, line),
        })
    rows.sort(key=lambda x: (-x["score"], -x["gm"]))
    key_absentee = rows[0] if rows else None

    # 라인별 최다 결장 선수(앵커용)
    line_top = {}
    for r in rows:
        cur = line_top.get(r["line"])
        if cur is None or r["gm"] > cur[1]:
            line_top[r["line"]] = (r["name"], r["gm"])

    # 임팩트 상위 9명을 고른 뒤, 카드 배치는 라인 순서(수비→중원→공격→GK)로 그룹화
    display = sorted(rows[:9], key=lambda x: (_LINE_ORDER.get(x["line"], 9), -x["score"]))
    cards = []
    for r in display:
        tone = _LINE_TONE[r["line"]]
        contrib = (
            f"{r['minutes']}분 · {r['goals']}골 {r['assists']}도움"
            + (f" · 평점 {r['rating']:.2f}" if r["rating"] else "")
            if r["minutes"] else "EPL 출전 기록 없음"
        )
        spell_top = r["spell_list"][:2]
        spell_rows = "".join(
            "<div style='font-size:11px;color:#3a4253;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>"
            f"<span style='color:#b91c1c;font-weight:900'>{_fmt_inj_date(s.get('from'))}~{_fmt_inj_date(s.get('until'))}</span>"
            f" · {html.escape(str(s.get('injury') or '부상'))} <span style='color:#8a93a5'>({int(s.get('games') or 0)}경기)</span></div>"
            for s in spell_top
        )
        more = len(r["spell_list"]) - len(spell_top)
        if more > 0:
            spell_rows += f"<div style='font-size:10.5px;color:#8a93a5;margin-top:3px'>＋{more}건 더 · 총 {r['spells']}회</div>"
        cards.append(
            "<div style='background:#fff;border:1px solid #e4e8f0;border-left:4px solid "
            f"{tone};border-radius:12px;padding:13px 14px;box-shadow:0 1px 3px rgba(16,24,40,.04)'>"
            "<div style='display:flex;align-items:center;gap:11px'>"
            f"{avatar(r['photo'], '#9aa3b2', 44, 'flex:none;filter:grayscale(.4)')}"
            "<div style='flex:1;min-width:0'>"
            f"<div style='font-size:14px;font-weight:950;color:#1a1f2e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>{html.escape(r['name'])}</div>"
            f"<div style='font-size:11px;color:#8a93a5;margin-top:2px'>{_LINE_LABEL[r['line']]}{(' · ' + html.escape(r['pos'])) if r['pos'] else ''}</div></div>"
            "<div style='text-align:right;flex:none'>"
            f"<div style='font-size:20px;font-weight:950;color:{tone};line-height:1'>{r['gm']}</div>"
            "<div style='font-size:9.5px;font-weight:900;color:#8a93a5'>경기 결장</div></div></div>"
            f"<div style='margin-top:10px'>{spell_rows}</div>"
            f"<div style='font-size:10.5px;color:#8a93a5;margin-top:9px;padding-top:8px;border-top:1px solid #f1f3f7'>시즌 출전 {html.escape(contrib)}</div>"
            "</div>"
        )

    # 라인별 비중: 팀 부상 공백(결장×시장가 가중) 중 각 라인이 차지하는 % (합 100).
    total_score = sum(line_score.values()) or 1.0
    present = [ln for ln in ["DF", "MF", "FW", "GK"] if line_count[ln]]
    strip = []
    for ln in present:
        share = int(round(line_score[ln] / total_score * 100))
        tone = _LINE_TONE[ln]
        top_name, top_gm = line_top.get(ln, ("", 0))
        anchor = f"최다 {html.escape(top_name.split()[-1] if top_name else '')} {top_gm}경기" if top_name else ""
        strip.append(
            "<div style='background:#fff;border:1px solid #e4e8f0;border-top:3px solid "
            f"{tone};border-radius:12px;padding:12px 13px'>"
            "<div style='display:flex;justify-content:space-between;align-items:baseline;gap:6px'>"
            f"<div style='font-size:12px;font-weight:950;color:#1a1f2e'>{_LINE_LABEL[ln]}</div>"
            f"<div style='font-size:11px;color:#8a93a5'>{line_count[ln]}명</div></div>"
            f"<div style='font-size:24px;font-weight:950;color:{tone};line-height:1;margin:6px 0 2px'>{share}<span style='font-size:13px'>%</span></div>"
            f"{_clean_bar(share, tone, 6)}"
            f"<div style='font-size:10.5px;color:#8a93a5;margin-top:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>{anchor}</div>"
            "</div>"
        )
    strip_html = "".join(strip) or "<div style='font-size:12px;color:#8a93a5'>라인별 영향 데이터 없음</div>"
    worst = max(present, key=lambda l: line_score[l], default=None)
    worst_share = int(round(line_score[worst] / total_score * 100)) if worst else 0
    worst_txt = f"가장 타격: {_LINE_LABEL[worst]} 라인 ({worst_share}%)" if worst else ""

    # ── Pros & Cons 진단 — 캐릭터성 있는 가용성 분석 ──────────────────────────
    def _short(n: str) -> str:
        return html.escape(n.split()[-1]) if n else ""

    def _val(mv: float) -> str:
        return fmt_value(mv) if mv and mv > 0 else ""

    # CONS — 몸값이 아니라 '출전 시 성과 × 결장 경기수'(regret)로 핵심 공백을 잡는다.
    #   핵심 공백 = 나왔을 때 평점이 좋았는데 너무 많이 빠진 선수(하베르츠·외데고르 류).
    cons = []
    for r in rows:
        sn, gm, sp = _short(r["name"]), r["gm"], r["spells"]
        rating = float(r.get("rating") or 0.0)
        mins = int(r.get("minutes") or 0)
        sig = r.get("sig") or ""
        # 성과 클로즈: 시그니처 스탯 우선, 없으면 평점/공격 포인트로 대체
        ga = r["goals"] + r["assists"]
        perf = sig or (f"평점 {rating:.2f}" if rating else (f"{r['goals']}골 {r['assists']}도움" if ga else ""))
        played = f"{mins}분 출전" if mins else "출전"
        sample = mins >= 400 and rating > 0      # 성과를 판단할 만한 출전 표본
        regret = gm * max(0.0, rating - 6.3) if sample else 0.0
        if sample and rating >= 6.7 and gm >= 8:
            perf_clause = f"{played} 동안 {perf} 기록으로 제 몫을 했지만" if perf else f"{played} 중 제 몫을 했지만"
            cons.append((100 + regret, "핵심 공백", "#dc2626", sn,
                f"{sn}은 {perf_clause} {gm}경기나 결장 — 풀시즌 가용이었다면 큰 전력, 공백을 메울 뎁스가 아쉽습니다."))
        elif sp >= 4:
            sig_clause = f" ({perf})" if perf else ""
            cons.append((50 + sp, "유리몸 리스크", "#ef4444", sn,
                f"{sn}은 시즌 {sp}회·{gm}경기 반복 결장{sig_clause} — 가용성이 불안정해 의존도를 낮출 뎁스가 필요합니다."))
        elif gm >= 12:
            sig_clause = f"{perf} 자원이지만 " if perf else ""
            cons.append((30 + gm * 0.1, "장기 결장", "#f97316", sn,
                f"{sn}은 {sig_clause}장기 결장 {gm}경기 — 복귀 일정과 폼 회복 속도를 주시해야 합니다."))
        else:
            cons.append((gm * 0.1, "로테이션 공백", "#f59e0b", sn,
                f"{sn} {gm}경기 결장 — 로테이션 부담이 누적됩니다."))
    cons.sort(key=lambda x: -x[0])
    cons = [c[1:] for c in cons[:3]]   # 정렬용 score 제거 → (tag, tone, sn, text)

    # PROS — 결장 없이 시즌을 버틴 가용성 앵커(철강왕)
    absent_norm = {_audit_norm(r["name"]): r["gm"] for r in rows}
    iron = []
    if not sq.empty and "player" in sq.columns:
        for _, p in sq.iterrows():
            _a = pd.to_numeric(p.get("ss_appearances"), errors="coerce")
            _m = pd.to_numeric(p.get("minutes"), errors="coerce")
            _v = pd.to_numeric(p.get("market_value_eur"), errors="coerce")
            apps = int(_a) if pd.notna(_a) else 0
            mins = int(_m) if pd.notna(_m) else 0
            mv = float(_v) if pd.notna(_v) else 0.0
            gm = absent_norm.get(_audit_norm(str(p.get("player", ""))), 0)
            if gm > 2:
                continue
            games = apps if apps > 0 else round(mins / 90)
            if games >= 33 or mins >= 2900:
                iron.append({"sn": _short(str(p.get("player", ""))), "apps": games,
                             "mins": mins, "mv": mv,
                             "sig": _signature_stat(p, _line_of(p.get("pos")))})
    iron.sort(key=lambda x: (-x["apps"], -x["mins"], -x["mv"]))
    iron = iron[:3]

    pros = []
    for i, p in enumerate(iron):
        sig = p.get("sig") or ""
        stat_clause = f"{sig} 기록" if sig else "꾸준한 폼 유지"
        if i == 0 and p["apps"] >= 36:
            pros.append(("철강왕", "#16a34a", p["sn"],
                f"{p['sn']}은 리그 {p['apps']}경기 전체를 소화하며 {stat_clause} — '철강왕' 가용성으로 팀의 버팀목입니다."))
        else:
            pros.append(("가용성 안정", "#0d9488", p["sn"],
                f"{p['sn']}은 {p['apps']}경기 출전에 {stat_clause} — 결장 거의 없이 꾸준한 가용성을 유지했습니다."))

    def _verdict_col(title: str, accent: str, items: list, empty: str) -> str:
        head = (
            "<div style='display:flex;align-items:center;gap:8px;margin-bottom:11px'>"
            f"<span style='width:4px;height:15px;background:{accent};border-radius:2px;"
            f"box-shadow:0 0 9px {accent}cc'></span>"
            f"<span style='font-size:11.5px;font-weight:950;color:{accent};letter-spacing:1.1px;"
            f"text-transform:uppercase'>{title}</span></div>"
        )
        if not items:
            body = f"<div style='font-size:11.5px;color:{_GE_MUT}'>{empty}</div>"
        else:
            body = "".join(
                "<div style='padding:9px 0;border-bottom:1px solid rgba(125,145,185,.12)'>"
                "<div style='display:flex;align-items:center;gap:7px'>"
                f"<span style='font-size:9px;font-weight:950;color:{tone};background:{tone}1f;"
                f"border:1px solid {tone}45;border-radius:4px;padding:2px 7px;letter-spacing:.5px'>{html.escape(tag)}</span>"
                f"<span style='font-size:12.5px;font-weight:950;color:{_GE_TXT}'>{sn}</span></div>"
                f"<div style='font-size:11px;color:{_GE_SUB};line-height:1.45;margin-top:5px'>{html.escape(text)}</div>"
                "</div>"
                for tag, tone, sn, text in items
            )
        return f"<div>{head}{body}</div>"

    verdict_panel = (
        "<div style='background:radial-gradient(120% 80% at 100% 0%,#0e1626,#0a0f1a);"
        "border:1px solid rgba(125,145,185,.14);border-radius:14px;padding:16px 18px;margin-bottom:16px;"
        "box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 10px 30px rgba(0,0,0,.28)'>"
        "<div style='display:flex;align-items:center;gap:9px;margin-bottom:13px'>"
        "<span style='font-size:13px;font-weight:950;color:#e8edf6;letter-spacing:1.3px;"
        "text-transform:uppercase'>가용성 진단</span>"
        f"<span style='font-size:10.5px;font-weight:800;color:#8a93a5'>PROS & CONS · 총 {len(rows)}명 결장</span></div>"
        "<div style='display:grid;grid-template-columns:1fr 1fr;gap:18px'>"
        f"{_verdict_col('강점 · 가용성 앵커', '#3ddc84', pros, '결장 없이 풀시즌을 버틴 앵커가 뚜렷하지 않습니다.')}"
        f"{_verdict_col('리스크 · 부상 공백', '#f87171', cons, '치명적 부상 공백은 제한적입니다.')}"
        "</div></div>"
    )

    return (
        "<div style='display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin:0 0 3px'>"
        "<div style='font-size:13px;font-weight:950;letter-spacing:.4px'>시즌 부상 결장 · Injury Impact</div>"
        f"<div style='font-size:11.5px;font-weight:900;color:{color}'>{worst_txt}</div></div>"
        f"<div style='display:grid;grid-template-columns:repeat({len(present)},1fr);gap:12px;margin-bottom:14px'>{strip_html}</div>"
        f"<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:12px;align-content:start;margin-bottom:12px'>{''.join(cards)}</div>"
        f"{verdict_panel}"
    )


# ── 상대·환경별 성과 (Match Factor Lab과 중복되지 않는 결과 각도) ──────────────
def _ppg_tone(ppg: float) -> str:
    if ppg >= 2.0:
        return "#16a34a"
    if ppg >= 1.3:
        return "#d97706"
    return "#ef4444"


def _context_performance_html(team: str, schedule: pd.DataFrame | None,
                              standings: pd.DataFrame | None, color: str) -> str:
    if schedule is None or schedule.empty or "result" not in schedule.columns:
        return ""
    sch = schedule[schedule["result"].notna()].copy()
    if sch.empty:
        return ""
    rank_map = {}
    if standings is not None and {"squad", "rank"} <= set(standings.columns):
        rank_map = {str(s): int(r) for s, r in zip(standings["squad"], standings["rank"])}

    def agg(rows: pd.DataFrame) -> dict:
        n = len(rows)
        w = int((rows["result"].astype(str) == "W").sum())
        d = int((rows["result"].astype(str) == "D").sum())
        l = int((rows["result"].astype(str) == "L").sum())
        gf = int(pd.to_numeric(rows.get("gf"), errors="coerce").fillna(0).sum())
        ga = int(pd.to_numeric(rows.get("ga"), errors="coerce").fillna(0).sum())
        ppg = (w * 3 + d) / n if n else 0.0
        return {"n": n, "w": w, "d": d, "l": l, "gf": gf, "ga": ga, "ppg": ppg}

    ha = sch["home_away"].astype(str).str.upper()
    home, away = agg(sch[ha.str.startswith("H")]), agg(sch[ha.str.startswith("A")])

    def tier_of(opp):
        r = rank_map.get(str(opp))
        if r is None:
            return None
        return "상위권" if r <= 6 else ("중위권" if r <= 13 else "하위권")
    sch["_tier"] = sch["opponent"].map(tier_of)
    tiers = {t: agg(sch[sch["_tier"] == t]) for t in ["상위권", "중위권", "하위권"]}

    def row(label: str, a: dict, note: str = "") -> str:
        if a["n"] == 0:
            return (f"<div style='display:flex;justify-content:space-between;align-items:center;"
                    f"padding:10px 0;border-bottom:1px solid {_GE_LINE}'>"
                    f"<div style='font-size:12.5px;font-weight:900;color:{_GE_SUB}'>{html.escape(label)}"
                    f"<span style='font-size:10.5px;color:{_GE_MUT};font-weight:700'> · {html.escape(note)}</span></div>"
                    f"<div style='font-size:11px;color:{_GE_MUT}'>경기 없음</div></div>")
        tone = _ppg_tone(a["ppg"])
        bar = max(3, min(100, int(round(a["ppg"] / 3 * 100))))
        track = (f"<div style='flex:1;height:7px;background:rgba(255,255,255,.06);border-radius:999px;overflow:hidden'>"
                 f"<div style='height:100%;width:{bar}%;background:linear-gradient(90deg,{tone}99,{tone});"
                 f"border-radius:999px;box-shadow:0 0 10px {tone}80'></div></div>")
        return (
            f"<div style='padding:11px 0;border-bottom:1px solid {_GE_LINE}'>"
            "<div style='display:flex;justify-content:space-between;align-items:baseline;gap:8px'>"
            f"<div style='font-size:12.5px;font-weight:900;color:{_GE_TXT}'>{html.escape(label)}"
            f"<span style='font-size:10.5px;color:{_GE_MUT};font-weight:700'> · {a['n']}경기{(' · ' + html.escape(note)) if note else ''}</span></div>"
            f"<div style='font-size:20px;font-weight:950;color:{tone};letter-spacing:-.5px;line-height:1;"
            f"text-shadow:0 0 14px {tone}66'>{a['ppg']:.2f}<span style='font-size:9px;color:{_GE_MUT};"
            f"font-weight:900;margin-left:3px;letter-spacing:.5px'>PPG</span></div></div>"
            "<div style='display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:7px'>"
            f"{track}"
            f"<div style='font-size:10.5px;font-weight:800;color:{_GE_SUB};white-space:nowrap'>"
            f"<span style='color:#3ddc84'>{a['w']}승</span> <span style='color:{_GE_MUT}'>{a['d']}무</span> "
            f"<span style='color:#f87171'>{a['l']}패</span> · 득실 {a['gf']}-{a['ga']}</div></div>"
            "</div>"
        )

    home_away_rows = row("홈", home) + row("원정", away)
    tier_rows = "".join(row(t, tiers[t]) for t in ["상위권", "중위권", "하위권"])

    def panel(title: str, sub: str, accent: str, rows_html: str) -> str:
        return (
            f"<div style='{_ge_panel_style(accent)};padding:16px 18px'>"
            f"<div style='font-size:12px;font-weight:950;color:{_GE_TXT};letter-spacing:1px;"
            f"text-transform:uppercase'>{html.escape(title)}</div>"
            f"<div style='font-size:10.5px;color:{_GE_MUT};margin:3px 0 8px'>{html.escape(sub)}</div>"
            f"{rows_html}</div>"
        )

    return (
        "<div style='display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px'>"
        f"{panel('홈 / 원정 성과', '장소별 경기당 승점·득실로 환경 의존도를 봅니다.', color, home_away_rows)}"
        f"{panel('상대 강도별 성과', '상위권(1–6)·중위권(7–13)·하위권(14–20) 상대 승점.', '#22d3ee', tier_rows)}"
        "</div>"
    )


# ── Main dashboard ───────────────────────────────────────────────────────────
def analytics_dashboard_html(
    team: str,
    formation: str,
    unit_metrics: pd.DataFrame | None,
    standings: pd.DataFrame | None,
    manager: dict | None,
    schedule: pd.DataFrame | None,
    full_df: pd.DataFrame,
    rep_df: pd.DataFrame,
    trait_weaknesses: list,
    statbunker: pd.DataFrame | None = None,
    transfers: pd.DataFrame | None = None,
    inj_hist: pd.DataFrame | None = None,
) -> str:
    df = _clean_unit_frame(unit_metrics)
    color = team_color(team)
    full_name = TEAM_EXTRA.get(team, (team, None))[0]
    logo = team_logo(team)
    crest = (
        f"<img src='{logo}' referrerpolicy='no-referrer' onerror=\"this.style.display='none'\" "
        "style='width:42px;height:42px;object-fit:contain'/>"
        if logo else f"<span style='font-size:15px;font-weight:950;color:#fff'>{html.escape(team[:3].upper())}</span>"
    )
    mgr = manager or {}
    mgr_name = str(mgr.get("name", "확인 필요"))
    mgr_style = str(mgr.get("style", "Tactical profile pending"))
    mgr_form = str(mgr.get("formation") or formation or "-")

    # rank rows → strengths / risks
    rank_rows = []
    for col in [c for c in _CLEAN_LABELS if c in df.columns]:
        rk, pct, val = _clean_rank(df, team, col)
        rank_rows.append((col, _CLEAN_LABELS[col], rk, pct, float(val)))
    strengths = sorted(rank_rows, key=lambda x: x[2])[:4]
    risks = sorted(rank_rows, key=lambda x: x[2], reverse=True)[:4]
    primary_strength = strengths[0][1] if strengths else "강점 데이터"
    primary_risk = risks[0][1] if risks else "리스크 데이터"
    profile_name, profile_traits, profile_positions = _ko_need_profile(primary_risk)

    def _quick_frame(frame: pd.DataFrame | None) -> pd.DataFrame:
        if frame is None or frame.empty:
            return pd.DataFrame()
        return frame.reset_index() if "squad" not in frame.columns else frame.copy()

    _stand_quick = _quick_frame(standings)
    _sb_quick = _quick_frame(statbunker)

    def _quick_num(frame: pd.DataFrame, col: str) -> float | None:
        if frame.empty or "squad" not in frame.columns or col not in frame.columns:
            return None
        hit = frame[frame["squad"].astype(str) == team]
        if hit.empty:
            return None
        val = pd.to_numeric(hit.iloc[0].get(col), errors="coerce")
        return float(val) if pd.notna(val) else None

    def _quick_player_rate(col: str) -> float | None:
        if full_df.empty or "squad" not in full_df.columns or col not in full_df.columns or "minutes" not in full_df.columns:
            return None
        sq = full_df[full_df["squad"].astype(str) == team].copy()
        if sq.empty:
            return None
        rates = pd.to_numeric(sq[col], errors="coerce").fillna(0)
        mins = pd.to_numeric(sq["minutes"], errors="coerce").fillna(0)
        played = _quick_num(_stand_quick, "played") or 38.0
        return float((rates * mins / 90.0).sum() / max(played, 1.0))

    def _quick_fmt(value: float | None, digits: int = 1, signed: bool = False) -> str:
        if value is None:
            return "n/a"
        if signed:
            return f"{value:+.{digits}f}"
        return f"{value:.{digits}f}"

    def signal_context(col: str) -> tuple[str, str]:
        played = _quick_num(_stand_quick, "played") or 38.0
        pts = _quick_num(_stand_quick, "points")
        gf = _quick_num(_stand_quick, "gf")
        ga = _quick_num(_stand_quick, "ga")
        gd = _quick_num(_stand_quick, "gd")
        if col == "overall_index":
            return f"{int(pts or 0)}점 · 득실 {_quick_fmt(gd, 0, True)}", f"경기당 승점 {_quick_fmt((pts / played) if pts is not None else None, 2)}"
        if col == "attack_index":
            return f"{int(gf or 0)}득점", f"경기당 {_quick_fmt((gf / played) if gf is not None else None, 2)}골"
        if col == "midfield_index":
            ft = _quick_player_rate("final_third_passes_per90")
            rec = _quick_player_rate("recoveries_per90")
            return f"전진패스 {_quick_fmt(ft, 1)}/경기", f"회수 {_quick_fmt(rec, 1)}/경기"
        if col == "defense_index":
            return f"{int(ga or 0)}실점", f"경기당 {_quick_fmt((ga / played) if ga is not None else None, 2)}실점"
        if col == "pressing_index":
            won = _quick_player_rate("possession_won_att_per90")
            rec = _quick_player_rate("recoveries_per90")
            return f"전방 탈환 {_quick_fmt(won, 1)}/경기", f"전체 회수 {_quick_fmt(rec, 1)}/경기"
        if col == "set_piece_attack_index":
            sp = _quick_num(_sb_quick, "non_penalty_set_piece_goals")
            corner = _quick_num(_sb_quick, "corner_goals")
            return f"세트피스 {int(sp or 0)}골", f"코너킥 {int(corner or 0)}골"
        return "n/a", "실측값 확인 필요"

    _ratings = team_ratings(team, pd.DataFrame(), standings, full_df, df)
    _rating_map = {label: (int(round(val)), note) for label, val, note in _ratings}
    _overall, _overall_note = _rating_map.get("종합 지수", (0, ""))
    _form, _form_note = _rating_map.get("시즌 폼", (_overall, ""))
    _attack, _attack_note = _rating_map.get("공격 지수", (0, ""))
    _midfield, _midfield_note = _rating_map.get("미드필드 지수", (0, ""))
    _defense, _defense_note = _rating_map.get("수비 지수", (0, ""))
    _sp_value, _sp_note = signal_context("set_piece_attack_index")
    _set_rating = 70
    if df is not None and not df.empty and team in df.index and "set_piece_attack_index" in df.columns:
        _raw_set = pd.to_numeric(df.loc[team].get("set_piece_attack_index"), errors="coerce")
        if pd.notna(_raw_set):
            _set_rating = int(max(58, min(92, round(58 + float(_raw_set) * 0.34))))

    signal_cards = (
        _ovr_hero_html(_overall, _overall_note or full_name, _ovr_tier(_overall))
        + "<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:10px'>"
        + _game_tile_html("공격 ATT", _attack, _attack_note)
        + _game_tile_html("중원 MID", _midfield, _midfield_note)
        + _game_tile_html("수비 DEF", _defense, _defense_note)
        + "</div>"
        + "<div style='display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:9px'>"
        + _game_tile_html("시즌 폼 FORM", _form, _form_note)
        + _game_tile_html("세트피스 SET", _set_rating, _sp_value)
        + "</div>"
    )

    def team_stat_row(frame: pd.DataFrame | None, target: str) -> pd.Series | None:
        if frame is None or frame.empty:
            return None
        src = frame.reset_index() if "squad" not in frame.columns else frame
        hit = src[src["squad"].astype(str) == target] if "squad" in src.columns else pd.DataFrame()
        return hit.iloc[0] if not hit.empty else None

    def stat_number(frame: pd.DataFrame | None, target: str, col: str) -> float | None:
        row = team_stat_row(frame, target)
        if row is None or col not in row.index:
            return None
        val = pd.to_numeric(row.get(col), errors="coerce")
        return float(val) if pd.notna(val) else None

    def league_avg(frame: pd.DataFrame | None, col: str) -> float | None:
        if frame is None or frame.empty or col not in frame.columns:
            return None
        vals = pd.to_numeric(frame[col], errors="coerce").dropna()
        return float(vals.mean()) if not vals.empty else None

    def played_for(target: str) -> float:
        val = stat_number(standings, target, "played")
        return val or 38.0

    def player_per_match(target: str, rate_col: str) -> float | None:
        if full_df.empty or "squad" not in full_df.columns or rate_col not in full_df.columns:
            return None
        sq = full_df[full_df["squad"].astype(str) == target].copy()
        if sq.empty or "minutes" not in sq.columns:
            return None
        rates = pd.to_numeric(sq[rate_col], errors="coerce").fillna(0)
        mins = pd.to_numeric(sq["minutes"], errors="coerce").fillna(0)
        return float((rates * mins / 90.0).sum() / max(played_for(target), 1.0))

    def player_avg_per_match(rate_col: str) -> float | None:
        if full_df.empty or "squad" not in full_df.columns or rate_col not in full_df.columns:
            return None
        vals = [player_per_match(str(t), rate_col) for t in full_df["squad"].dropna().astype(str).unique()]
        vals = [v for v in vals if v is not None]
        return float(sum(vals) / len(vals)) if vals else None

    def player_combo(target: str, cols: list[str]) -> float | None:
        vals = [player_per_match(target, c) for c in cols]
        vals = [v for v in vals if v is not None]
        return float(sum(vals)) if vals else None

    def player_combo_avg(cols: list[str]) -> float | None:
        vals = []
        if full_df.empty or "squad" not in full_df.columns:
            return None
        for target in full_df["squad"].dropna().astype(str).unique():
            v = player_combo(str(target), cols)
            if v is not None:
                vals.append(v)
        return float(sum(vals) / len(vals)) if vals else None

    def weighted_avg(target: str, col: str) -> float | None:
        if full_df.empty or "squad" not in full_df.columns or col not in full_df.columns or "minutes" not in full_df.columns:
            return None
        sq = full_df[full_df["squad"].astype(str) == target].copy()
        if sq.empty:
            return None
        vals = pd.to_numeric(sq[col], errors="coerce")
        mins = pd.to_numeric(sq["minutes"], errors="coerce").fillna(0)
        good = vals.notna() & (mins > 0)
        if not good.any():
            return None
        return float((vals[good] * mins[good]).sum() / mins[good].sum())

    def weighted_avg_league(col: str) -> float | None:
        vals = []
        if full_df.empty or "squad" not in full_df.columns:
            return None
        for target in full_df["squad"].dropna().astype(str).unique():
            v = weighted_avg(str(target), col)
            if v is not None:
                vals.append(v)
        return float(sum(vals) / len(vals)) if vals else None

    def fmt_num(value: float | None, suffix: str = "", digits: int = 1) -> str:
        if value is None:
            return "n/a"
        if digits == 0:
            return f"{value:.0f}{suffix}"
        return f"{value:.{digits}f}{suffix}"

    def avg_note(value: float | None, avg: float | None, suffix: str = "", digits: int = 1, lower_good: bool = False) -> str:
        if value is None or avg is None:
            return "리그 평균 비교 데이터 대기"
        diff = avg - value if lower_good else value - avg
        word = "적음" if (diff >= 0 and lower_good) or (diff < 0 and not lower_good) else "많음"
        return f"리그 평균보다 {fmt_num(abs(diff), suffix, digits)} {word}"

    def metric_context(col: str, rank: int) -> tuple[str, str]:
        gf = stat_number(standings, team, "gf")
        ga = stat_number(standings, team, "ga")
        played = played_for(team)
        if col in ("overall_index",):
            pts = stat_number(standings, team, "points")
            gd = stat_number(standings, team, "gd")
            return f"승점 {fmt_num(pts, '', 0)} · 득실 {fmt_num(gd, '', 0)}", f"리그 {rank}위 흐름"
        if col in ("attack_index", "attack_output_index"):
            avg_gf = league_avg(standings, "gf")
            return f"득점 {fmt_num(gf, '', 0)} · 경기당 {fmt_num(gf / played if gf is not None else None, '', 2)}", avg_note(gf, avg_gf, "", 0)
        if col == "attack_creation_index":
            kp = player_per_match(team, "key_passes_per90")
            bc = player_per_match(team, "big_chances_created_per90")
            return f"키패스 {fmt_num(kp, '/경기', 1)} · 빅찬스 {fmt_num(bc, '/경기', 1)}", avg_note(kp, player_avg_per_match("key_passes_per90"), "/경기", 1)
        if col == "set_piece_attack_index":
            sp = stat_number(statbunker, team, "non_penalty_set_piece_goals")
            corner = stat_number(statbunker, team, "corner_goals")
            return f"세트피스 득점 {fmt_num(sp, '', 0)} · 코너킥 골 {fmt_num(corner, '', 0)}", avg_note(sp, league_avg(statbunker, "non_penalty_set_piece_goals"), "", 1)
        if col == "penalty_control_index":
            pf = stat_number(statbunker, team, "penalties_for")
            pa = stat_number(statbunker, team, "penalties_against")
            return f"획득 PK {fmt_num(pf, '', 0)} · 허용 PK {fmt_num(pa, '', 0)}", "PK 이벤트 기준"
        if col in ("midfield_index", "midfield_control_index"):
            pass_pct = weighted_avg(team, "pass_pct")
            ft = player_per_match(team, "final_third_passes_per90")
            return f"패스 성공률 {fmt_num(pass_pct, '%', 1)} · 전진패스 {fmt_num(ft, '/경기', 1)}", avg_note(ft, player_avg_per_match("final_third_passes_per90"), "/경기", 1)
        if col == "midfield_creativity_index":
            kp = player_per_match(team, "key_passes_per90")
            xa = player_per_match(team, "xa_p90")
            return f"키패스 {fmt_num(kp, '/경기', 1)} · xA {fmt_num(xa, '/경기', 2)}", avg_note(kp, player_avg_per_match("key_passes_per90"), "/경기", 1)
        if col in ("midfield_ball_winning_index", "pressing_index"):
            rec = player_per_match(team, "recoveries_per90")
            won = player_per_match(team, "possession_won_att_per90")
            return f"회수 {fmt_num(rec, '/경기', 1)} · 전방 탈환 {fmt_num(won, '/경기', 1)}", avg_note(won, player_avg_per_match("possession_won_att_per90"), "/경기", 1)
        if col in ("defense_index", "defense_output_index"):
            avg_ga = league_avg(standings, "ga")
            return f"실점 {fmt_num(ga, '', 0)} · 경기당 {fmt_num(ga / played if ga is not None else None, '', 2)}", avg_note(ga, avg_ga, "", 0, lower_good=True)
        if col == "defense_disruption_index":
            disrupt = player_combo(team, ["tackles_won_per90_ss", "interceptions_per90_ss", "outfielder_blocks_per90"])
            avg = player_combo_avg(["tackles_won_per90_ss", "interceptions_per90_ss", "outfielder_blocks_per90"])
            return f"태클+차단 {fmt_num(disrupt, '/경기', 1)}", avg_note(disrupt, avg, "/경기", 1)
        if col == "defense_box_aerial_index":
            aerial = player_per_match(team, "aerial_won_per90")
            clear = player_per_match(team, "clearances_per90")
            return f"공중볼 {fmt_num(aerial, '/경기', 1)} · 클리어 {fmt_num(clear, '/경기', 1)}", avg_note(aerial, player_avg_per_match("aerial_won_per90"), "/경기", 1)
        if col == "discipline_index":
            yc = stat_number(statbunker, team, "yellow_cards_per_match")
            rc = stat_number(statbunker, team, "red_cards")
            return f"경고 {fmt_num(yc, '/경기', 2)} · 퇴장 {fmt_num(rc, '', 0)}", avg_note(yc, league_avg(statbunker, "yellow_cards_per_match"), "/경기", 2, lower_good=True)
        return f"실제 지표 {fmt_num(stat_number(df, team, col), '', 1)}", f"리그 {rank}위"

    def _split_hero(main: str) -> tuple[str, str, str, str]:
        """'실점 27 · 경기당 0.71' → (값='27', 단위='', 캡션='실점', 상세='경기당 0.71').
        헤드라인 세그먼트의 마지막 숫자(+단위)를 히어로로 분리한다."""
        parts = [p.strip() for p in main.split(" · ") if p.strip()]
        head = parts[0] if parts else main
        detail = " · ".join(parts[1:])
        m = re.match(r"^(.*?)\s*([0-9][0-9,\.]*)\s*(%|/경기)?\s*$", head)
        if m:
            return m.group(2), (m.group(3) or ""), m.group(1).strip(), detail
        return "", "", head, detail

    def evidence_rows(rows: list[tuple], tone: str, mode: str) -> str:
        out = []
        for col, label, rk, pct, score in rows:
            main, sub = metric_context(col, rk)
            value, unit, caption, detail = _split_hero(main)
            compare = "리그 상위권" if rk <= 5 else ("리그 중위권" if rk <= 14 else "리그 하위권")
            lead = "강점 유지" if mode == "strength" else "보강 검토"

            if value:
                hero = (
                    f"<span style='font-size:27px;font-weight:950;color:{tone};line-height:1;"
                    f"letter-spacing:-.6px'>{html.escape(value)}</span>"
                    f"<span style='font-size:12px;font-weight:900;color:{tone};margin-left:1px'>{html.escape(unit)}</span>"
                )
                cap_block = (
                    f"<div style='font-size:12px;font-weight:900;color:#1a1f2e;line-height:1.2'>{html.escape(caption)}</div>"
                    + (f"<div style='font-size:11px;color:#667085;line-height:1.3;margin-top:1px'>{html.escape(detail)}</div>"
                       if detail else "")
                )
            else:  # 숫자를 못 뽑은 예외 케이스 — 캡션 텍스트를 그대로 노출
                hero = f"<span style='font-size:15px;font-weight:900;color:{tone}'>—</span>"
                cap_block = f"<div style='font-size:12px;font-weight:900;color:#1a1f2e'>{html.escape(caption or main)}</div>"

            out.append(
                "<div style='padding:13px 0;border-bottom:1px solid #f1f3f7'>"
                # 상단: 지표 라벨 + 상태 pill
                "<div style='display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px'>"
                f"<div style='font-size:12.5px;font-weight:900;color:#1a1f2e'>{html.escape(label)}</div>"
                f"<div style='font-size:9.5px;font-weight:950;color:{tone};background:{tone}14;"
                f"border:1px solid {tone}28;border-radius:999px;padding:3px 9px'>{lead}</div></div>"
                # 히어로: 큰 수치 + 캡션/상세 + 순위
                "<div style='display:flex;align-items:center;gap:12px'>"
                f"<div style='flex:none;min-width:54px'>{hero}</div>"
                f"<div style='flex:1;min-width:0'>{cap_block}</div>"
                "<div style='text-align:right;flex:none'>"
                f"<div style='font-size:17px;font-weight:950;color:{tone};line-height:1'>{rk}위</div>"
                f"<div style='font-size:9px;font-weight:800;color:#8a93a5;letter-spacing:.3px;margin-top:2px'>{compare}</div>"
                "</div></div>"
                # 백분위 바 + 리그평균 비교 캡션
                f"{_clean_bar(pct, tone, 6)}"
                f"<div style='font-size:10.5px;color:#8a93a5;margin-top:6px'>{html.escape(sub)}</div>"
                "</div>"
            )
        return "".join(out) or "<div style='font-size:12px;color:#8a93a5'>표시할 근거가 없습니다.</div>"

    sq_full = full_df[full_df["squad"].astype(str) == team] if "squad" in full_df.columns else pd.DataFrame()
    avg_rating = 0.0
    if not sq_full.empty and "ss_rating" in sq_full.columns:
        avg_rating = float(pd.to_numeric(sq_full["ss_rating"], errors="coerce").dropna().mean())
    sample_size = len(sq_full) if not sq_full.empty else 0

    factor_cards = _build_match_factor_cards(team, df, full_df, statbunker)
    injury_html = _injury_impact_html(team, inj_hist, full_df, color) or ""
    context_html = _context_performance_html(team, schedule, standings, color) or ""
    audit_html = _recruitment_audit_html(team, transfers, full_df, color) or ""

    return f"""
    <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#1a1f2e">

      <!-- 1. Header -->
      <div style="background:linear-gradient(135deg,{color},#10151c);border-radius:16px;padding:20px 22px;
                  color:#fff;margin-bottom:16px;box-shadow:0 12px 32px rgba(16,24,40,.16)">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap">
          <div style="display:flex;align-items:center;gap:14px;min-width:280px">
            <div style="width:56px;height:56px;border-radius:14px;background:rgba(255,255,255,.14);
                        border:1px solid rgba(255,255,255,.20);display:flex;align-items:center;
                        justify-content:center">{crest}</div>
            <div>
              <div style="font-size:11px;font-weight:950;color:rgba(255,255,255,.64);letter-spacing:.9px">ANALYTICS BRIEF</div>
              <div style="font-size:24px;font-weight:950;line-height:1.08">{html.escape(full_name)}</div>
              <div style="font-size:12px;color:rgba(255,255,255,.72);margin-top:4px">
                {html.escape(mgr_name)} · {html.escape(mgr_form)} · {html.escape(mgr_style)}</div>
            </div>
          </div>
          <div style="flex:1;min-width:320px;max-width:540px">
            <div style="display:flex;gap:10px;flex-wrap:wrap">
              <div style="flex:1;min-width:130px;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.16);border-radius:11px;padding:9px 12px">
                <div style="font-size:9.5px;font-weight:950;letter-spacing:.9px;color:#86efac">강점</div>
                <div style="font-size:15px;font-weight:950;color:#fff;margin-top:2px">{html.escape(primary_strength)}</div>
              </div>
              <div style="flex:1;min-width:130px;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.16);border-radius:11px;padding:9px 12px">
                <div style="font-size:9.5px;font-weight:950;letter-spacing:.9px;color:#fca5a5">보강 포인트</div>
                <div style="font-size:15px;font-weight:950;color:#fff;margin-top:2px">{html.escape(primary_risk)}</div>
              </div>
            </div>
            <div style="margin-top:10px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:11px;padding:10px 13px">
              <div style="font-size:9.5px;font-weight:950;letter-spacing:1px;color:rgba(255,255,255,.6)">SCOUT TARGET · 스카우트 타깃</div>
              <div style="font-size:15px;font-weight:950;color:#fff;margin-top:3px">
                {html.escape(profile_name)} <span style="font-weight:800;color:rgba(255,255,255,.66)">· {html.escape(profile_positions)}</span></div>
              <div style="font-size:11.5px;color:rgba(255,255,255,.74);margin-top:3px">{html.escape(profile_traits)}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Radar + signal cards -->
      <div style="display:grid;grid-template-columns:1.02fr .98fr;gap:16px;margin-bottom:16px">
        <div style="background:#fff;border:1px solid #e4e8f0;border-radius:14px;padding:17px 18px;box-shadow:0 1px 3px rgba(16,24,40,.04)">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px">
            <div style="font-size:13px;font-weight:950;letter-spacing:.4px">팀 능력치 레이더</div>
            <span style="font-size:10px;font-weight:900;color:#667085;background:#f8fafc;border:1px solid #e4e8f0;border-radius:999px;padding:4px 10px">{sample_size}명 표본</span>
          </div>
          <div style="font-size:11px;color:#8a93a5;margin-bottom:4px">선수단 전력과 시즌 폼을 분리한 FIFA식 팀 프로필입니다.</div>
          <div style="text-align:center">{_clean_radar(team, df, full_df, standings, statbunker, color)}</div>
        </div>
        <div>{signal_cards}</div>
      </div>

      <!-- 3. Match Factor Lab -->
      {_ge_section_title('Match Factor Lab', '강점·약점 팩터 엔진', '#3ddc84')}
      <div style="margin-bottom:16px">{factor_cards}</div>

      <!-- 4. Injury impact -->
      {injury_html}

      <!-- 5. 상대·환경별 성과 (홈/원정 + 상대 강도별) -->
      {_ge_section_title('상대·환경별 성과', 'CONTEXT PERFORMANCE', '#22d3ee')}
      {context_html}

      <!-- 5. Recruitment audit -->
      {audit_html}

      <!-- Handoff strip -->
      <div style="background:linear-gradient(135deg,#10151c,#1a2235);border-radius:14px;padding:15px 18px;color:#fff;
                  display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;
                  box-shadow:0 8px 24px rgba(16,24,40,.16)">
        <div style="font-size:12px;font-weight:950;color:#fb923c;letter-spacing:.7px">TRANSFER AGENT 입력 신호</div>
        <div>
          {_agent_tag("avg_rating", f"{avg_rating:.2f}" if avg_rating else "n/a", "#fb923c")}
          {_agent_tag("보강", primary_risk, "#fb923c")}
          {_agent_tag("표본", f"{sample_size}명", "#fb923c")}
        </div>
      </div>
    </div>
    """
