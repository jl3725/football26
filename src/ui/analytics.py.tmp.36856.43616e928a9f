# ── Frame / ranking helpers ──────────────────────────────────────────────────
def _clean_unit_frame(unit_metrics: pd.DataFrame | None) -> pd.DataFrame:
    if unit_metrics is None or unit_metrics.empty:
        return pd.DataFrame()
    df = unit_metrics.copy()
    if "squad" in df.columns:
        df = df.set_index("squad")
    return df


def _clean_rank(df: pd.DataFrame, team: str, col: str, high_good: bool = True) -> tuple[int, int, float]:
    if df.empty or col not in df.columns or team not in df.index:
        return 10, 50, 50.0
    s = pd.to_numeric(df[col], errors="coerce").dropna()
    if s.empty or team not in s.index:
        return 10, 50, 50.0
    rank = int(s.rank(ascending=not high_good, method="min")[team])
    pct = int(round((1 - (rank - 1) / max(len(s) - 1, 1)) * 100))
    val = float(s.loc[team])
    return rank, max(0, min(100, pct)), val


def _clean_bar(value: int, color: str, h: int = 7) -> str:
    value = max(0, min(100, int(value)))
    return (
        f"<div style='height:{h}px;background:#eef1f6;border-radius:999px;overflow:hidden;margin-top:8px'>"
        f"<div style='height:100%;width:{value}%;background:{color};border-radius:999px'></div></div>"
    )


def _clean_radar(
    team: str,
    df: pd.DataFrame,
    full_df: pd.DataFrame,
    standings: pd.DataFrame | None,
    statbunker: pd.DataFrame | None,
    color: str,
) -> str:
    ratings = team_ratings(team, pd.DataFrame(), standings, full_df, df)
    rating_map = {label: int(round(val)) for label, val, _ in ratings}
    set_piece = 70
    if df is not None and not df.empty and team in df.index and "set_piece_attack_index" in df.columns:
        raw = pd.to_numeric(df.loc[team].get("set_piece_attack_index"), errors="coerce")
        if pd.notna(raw):
            set_piece = int(max(58, min(92, round(58 + float(raw) * 0.34))))
    axes = [
        ("SQUAD", rating_map.get("종합 지수", 70)),
        ("FORM", rating_map.get("시즌 폼", 70)),
        ("ATT", rating_map.get("공격 지수", 70)),
        ("MID", rating_map.get("미드필드 지수", 70)),
        ("DEF", rating_map.get("수비 지수", 70)),
        ("SET", set_piece),
    ]
    vals = [(label, max(0.18, min(0.98, value / 99)), str(value)) for label, value in axes]
    n = len(vals)
    W = H = 360
    cx = cy = W / 2
    R = 112

    def pt(i: int, frac: float) -> tuple[float, float]:
        ang = -math.pi / 2 + 2 * math.pi * i / n
        return cx + R * frac * math.cos(ang), cy + R * frac * math.sin(ang)

    rings = "".join(
        f"<polygon points='{' '.join(f'{x:.1f},{y:.1f}' for x, y in (pt(i, g) for i in range(n)))}' "
        f"fill='none' stroke='{color}' stroke-opacity='.16' stroke-width='1'/>"
        for g in (0.25, 0.5, 0.75, 1.0)
    )
    spokes = "".join(
        f"<line x1='{cx}' y1='{cy}' x2='{x:.1f}' y2='{y:.1f}' stroke='{color}' stroke-opacity='.13' stroke-width='1'/>"
        for x, y in (pt(i, 1.0) for i in range(n))
    )
    poly = " ".join(f"{x:.1f},{y:.1f}" for x, y in (pt(i, v) for i, (_, v, _) in enumerate(vals)))
    dots = "".join(
        f"<circle cx='{x:.1f}' cy='{y:.1f}' r='3.6' fill='{color}' stroke='#fff' stroke-width='2'/>"
        for x, y in (pt(i, v) for i, (_, v, _) in enumerate(vals))
    )
    pills = []
    for i, (label, _v, shown) in enumerate(vals):
        lx, ly = pt(i, 1.30)
        pills.append(
            f"<text x='{lx:.1f}' y='{ly-9:.1f}' fill='#5a6577' font-size='10.5' "
            f"font-weight='950' letter-spacing='.5' text-anchor='middle'>{label}</text>"
            f"<rect x='{lx-17:.1f}' y='{ly-1:.1f}' width='34' height='18' rx='9' "
            f"fill='{color}'/>"
            f"<text x='{lx:.1f}' y='{ly+12:.1f}' fill='#fff' font-size='12' "
            f"font-weight='950' text-anchor='middle'>{shown}</text>"
        )
    return (
        f"<svg viewBox='0 0 {W} {H}' width='100%' style='max-width:340px'>"
        "<defs>"
        "<radialGradient id='radBg' cx='50%' cy='40%' r='78%'>"
        "<stop offset='0%' stop-color='#ffffff'/>"
        f"<stop offset='62%' stop-color='{color}' stop-opacity='.07'/>"
        f"<stop offset='100%' stop-color='{color}' stop-opacity='.20'/>"
        "</radialGradient>"
        f"<linearGradient id='radFill' x1='0' y1='0' x2='0' y2='1'>"
        f"<stop offset='0%' stop-color='{color}' stop-opacity='.80'/>"
        f"<stop offset='100%' stop-color='{color}' stop-opacity='.42'/></linearGradient>"
        "<filter id='radGlow' x='-30%' y='-30%' width='160%' height='160%'>"
        "<feGaussianBlur stdDeviation='3.2' result='b'/>"
        "<feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter>"
        "</defs>"
        f"<rect x='0' y='0' width='{W}' height='{H}' rx='18' fill='url(#radBg)' "
        f"stroke='{color}' stroke-opacity='.18'/>"
        f"{rings}{spokes}"
        f"<polygon points='{poly}' fill='url(#radFill)' stroke='{color}' stroke-width='2.8' "
        f"stroke-linejoin='round' filter='url(#radGlow)'/>"
        f"{dots}{''.join(pills)}</svg>"
    )


# ── Need-profile / chips / cards ─────────────────────────────────────────────
def _ko_need_profile(label: str) -> tuple[str, str, str]:
    text = str(label)
    if any(k in text for k in ["압박", "볼 회수", "중원"]):
        return "수비형/박스투박스 MF", "압박 지속성, 볼 회수, 전진 패스", "CDM / CM"
    if any(k in text for k in ["창의", "찬스", "공격"]):
        return "창의형 8/10번", "박스 진입 패스, 키패스, 하프스페이스 점유", "CM / AM"
    if any(k in text for k in ["수비", "공중", "박스", "전환"]):
        return "전환 대응 수비수", "커버 범위, 공중전, 전진 수비", "CB / FB"
    if "세트" in text:
        return "세트피스 타깃/키커", "공중전, 킥 품질, 박스 점유", "CB / ST / AM"
    return "멀티롤 로테이션", "출전 안정성, 전술 적응도, 포지션 유연성", "멀티 포지션"


def _agent_tag(label: str, value: str, color: str = "#1a1f2e") -> str:
    return (
        f"<span style='display:inline-flex;align-items:center;gap:6px;padding:7px 10px;"
        f"border-radius:999px;background:{color}10;border:1px solid {color}24;color:{color};"
        f"font-size:11px;font-weight:900;margin:0 6px 7px 0'>"
        f"<span style='color:#8a93a5;font-weight:800'>{html.escape(label)}</span>{html.escape(value)}</span>"
    )


def _brief_metric_card(label: str, rank, color: str, value: str, note: str) -> str:
    badge = f"{rank}위" if isinstance(rank, int) else str(rank)
    return (
        "<div style='background:#fff;border:1px solid #e4e8f0;border-radius:12px;padding:14px 15px;"
        "box-shadow:0 1px 3px rgba(16,24,40,.04)'>"
        "<div style='display:flex;justify-content:space-between;align-items:center;gap:10px'>"
        f"<div style='font-size:11px;font-weight:950;color:#8a93a5;letter-spacing:.55px'>{html.escape(label)}</div>"
        f"<div style='font-size:10px;font-weight:950;color:{color};background:{color}14;"
        f"border:1px solid {color}28;border-radius:999px;padding:3px 8px'>{html.escape(badge)}</div></div>"
        f"<div style='font-size:20px;font-weight:950;color:#1a1f2e;line-height:1.12;margin-top:10px'>{html.escape(value)}</div>"
        f"<div style='font-size:11.5px;color:#667085;line-height:1.38;margin-top:8px'>{html.escape(note)}</div>"
        "</div>"
    )


# ── FIFA식 OVR 게임 그래픽 ────────────────────────────────────────────────────
def _ovr_tier(value: int) -> tuple[str, str, str]:
    """OVR 값 → (밝은색, 진한색, 등급명). FUT 카드식 티어 그라데이션."""
    if value >= 85:
        return ("#f9dd7e", "#c2902a", "ELITE")      # gold
    if value >= 80:
        return ("#5fe2a2", "#0a9c62", "STRONG")     # emerald
    if value >= 75:
        return ("#6fb1fb", "#1f63cf", "SOLID")      # steel-blue
    return ("#9fb0c3", "#536276", "DEVELOPING")     # slate


